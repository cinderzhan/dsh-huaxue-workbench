{
  "name": "dsh-huaxue-workbench",
  "version": "0.3.5-desktop.1",
  "description": "花少2花学工作台：Desktop 标准适配与独立宿主入口",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./desktop.js",
  "exports": {
    ".": "./desktop.js",
    "./client": "./desktop-client.js",
    "./standalone": "./index.js",
    "./standalone/client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "desktop.js",
    "desktop-client.js",
    "workbench.json",
    "client.js",
    "src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "INSTALL.md",
    "VALIDATION.md",
    "RIGHTS.md",
    "DESKTOP-ADAPTER.md",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build && npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  }
}
